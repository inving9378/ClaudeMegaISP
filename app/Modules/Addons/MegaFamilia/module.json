        { "name": "megafamilia_view",    "description": "Ver el panel de MegaFamilia (clientes y licencias)" },
        { "name": "megafamilia_support", "description": "Soporte: ver perfiles, dispositivos y alertas de clientes" },
        { "name": "megafamilia_admin",   "description": "Administrar MegaFamilia: configurar, activar/desactivar licencias" }
    ],

    "menu": [
        {
            "label": "MegaFamilia",
            "icon": "shield",
            "permission": "megafamilia_view",
            "url": "/megafamilia",
            "children": [
                { "label": "Dashboard",  "url": "/megafamilia",          "permission": "megafamilia_view" },
                { "label": "Clientes",   "url": "/megafamilia/clientes", "permission": "megafamilia_support" }
            ]
        }
    ],

    "admin_cards": [
        {
            "title": "MegaFamilia",
            "description": "Control parental para clientes: perfiles, dispositivos, reglas y geofences.",
            "icon": "shield-alt",
            "url": "/megafamilia",
            "permission": "megafamilia_view"
        }
    ],

    "config_sections": [
        {
            "key": "megafamilia_panel",
            "label": "MegaFamilia — Control Parental",
            "type": "general",
            "category": "Sistema",
            "icon": "shield",
            "url": "/megafamilia",
            "permission": "megafamilia_admin",
            "description": "Control parental y servicios familiares para clientes del ISP.",
            "doc": {
                "terms": [
                    {
                        "term": "MegaFamilia",
                        "definition": "Módulo de control parental que los clientes gestionan desde su app móvil."
                    }
                ],
                "steps": [
                    "Ve a Configuración → MegaFamilia.",
                    "Administra los servicios y configuración del módulo."
                ],
                "actions": [
                    "Gestionar clientes MegaFamilia"
                ]
            }
        }
