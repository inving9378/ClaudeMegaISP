    "api_endpoints": [
        { "method": "GET", "path": "/megafamilia",          "description": "Dashboard MegaFamilia",  "scope": "megafamilia_view",    "permission": "megafamilia_view" },
        { "method": "GET", "path": "/megafamilia/clientes", "description": "Lista clientes activos", "scope": "megafamilia_support", "permission": "megafamilia_support" },
        { "method": "POST", "path": "/api/megafamilia/auth/login",              "description": "Login de la app móvil (retorna token sanctum)",      "scope": "public",         "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/app-version",             "description": "Consulta de versión OTA de la app móvil",             "scope": "public",         "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/mobile/check-update",     "description": "Chequeo de actualización disponible del APK",         "scope": "public",         "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/mobile/download/{id}",    "description": "Descarga del APK de una versión",                     "scope": "public",         "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/account",                 "description": "Cuenta del cliente autenticado (app móvil)",          "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/servicio",                "description": "Datos del servicio de internet contratado",           "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/tickets",                 "description": "Lista de tickets del cliente",                        "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/tickets",                 "description": "Crea un ticket de soporte desde la app",              "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/tickets/{id}",            "description": "Detalle de un ticket + respuestas del técnico",       "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/tickets/{id}/attachment", "description": "Adjunta/reemplaza la foto de un ticket",              "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/tickets/{id}/rate",       "description": "Califica un ticket cerrado/resuelto",                 "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profile",                 "description": "Perfil del cliente autenticado",                      "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/facturas",                "description": "Lista de facturas del cliente",                       "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/pagos",                   "description": "Historial de pagos del cliente",                      "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/pagos",                   "description": "Registra un pago desde la app",                       "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profiles",                "description": "Lista de perfiles de hijos",                          "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/profiles",                "description": "Crea un perfil de hijo",                              "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profiles/{id}",           "description": "Detalle de un perfil de hijo",                        "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profiles/{id}/devices",   "description": "Dispositivos vinculados a un perfil",                 "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profiles/{id}/tasks",     "description": "Tareas asignadas a un perfil",                        "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/profiles/{id}/location",  "description": "Última ubicación conocida de un perfil",              "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/devices/{id}/rules",      "description": "Reglas de acceso de un dispositivo",                  "scope": "sanctum_mobile", "permission": null },
        { "method": "PUT",  "path": "/api/megafamilia/devices/{id}/rules",      "description": "Actualiza reglas de acceso de un dispositivo",        "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/tasks/{id}/complete",     "description": "Marca una tarea como completada",                     "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/hijo/tareas",             "description": "Tareas del hijo autenticado (app hijo)",              "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/requests",                "description": "Crea una solicitud (ej. tiempo extra)",               "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/requests/pending",        "description": "Solicitudes pendientes de respuesta",                 "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/locations",               "description": "Reporta la ubicación GPS del dispositivo",            "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/sync-status",             "description": "Estado de sincronización de datos de la app móvil",   "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/devices/link",            "description": "Vincula un dispositivo (MAC) a un perfil de hijo",    "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/profiles/{id}/invite",    "description": "Invita/vincula un dispositivo hijo a un perfil",      "scope": "sanctum_mobile", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/requests/{id}/respond",   "description": "Responde (aprueba/rechaza) una solicitud de tiempo extra", "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/tecnico/ordenes",         "description": "Órdenes de trabajo asignadas al técnico (app móvil)", "scope": "sanctum_mobile", "permission": null },
        { "method": "PUT",  "path": "/api/megafamilia/tecnico/ordenes/{id}",    "description": "Actualiza el estado/resultado de una orden de trabajo del técnico", "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/vehiculo",              "description": "Vehículo de flota asignado al conductor autenticado",         "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/posicion-actual",       "description": "Última posición GPS del vehículo del conductor",              "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/historial-posiciones",  "description": "Historial de posiciones GPS del vehículo del conductor",      "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/geocercas",             "description": "Geocercas asignadas al vehículo del conductor",               "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/eventos-geocerca",      "description": "Eventos de entrada\/salida de geocerca del vehículo del conductor", "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/documentos",            "description": "Documentos del vehículo asignado al conductor",               "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/conductor/mantenimientos",        "description": "Mantenimientos del vehículo asignado al conductor",           "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "POST", "path": "/api/megafamilia/conductor/posicion",              "description": "Reporta la posición GPS del vehículo desde la app del conductor", "scope": "sanctum_mobile_conductor", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/tiene-flotas",     "description": "Indica si el cliente autenticado tiene vehículos de flota",   "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos",        "description": "Lista de vehículos de flota del cliente",                     "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos/{id}",   "description": "Detalle de un vehículo de flota del cliente",                 "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos/{id}/historial-posiciones", "description": "Historial de posiciones GPS de un vehículo del cliente", "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos/{id}/eventos-geocerca",     "description": "Eventos de geocerca de un vehículo del cliente",         "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos/{id}/documentos",           "description": "Documentos de un vehículo del cliente",                  "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/vehiculos/{id}/mantenimientos",       "description": "Mantenimientos de un vehículo del cliente",              "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/geocercas",        "description": "Geocercas de la flota del cliente",                           "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/resumen",          "description": "Resumen de la flota del cliente (conteos y estado)",          "scope": "sanctum_mobile", "permission": null },
        { "method": "GET",  "path": "/api/megafamilia/cliente/flotas/plan",             "description": "Plan\/licencia de flota contratado por el cliente",           "scope": "sanctum_mobile", "permission": null }
    ],

    "ai": {
        "knowledge": "MegaFamilia es el servicio de control parental del ISP. Los clientes lo gestionan desde la app móvil (Android). Permite crear perfiles de hijos, agregar dispositivos por MAC, definir reglas de acceso (horarios, bloqueo de categorías), geofences y tareas familiares. Las licencias se activan por plan de internet.",
        "example_intents": [
            "ver los clientes con MegaFamilia activo",
            "activar MegaFamilia para un cliente",
            "ver las alertas del módulo parental",
            "descargar la app MegaFamilia"
        ],
        "sensitive_actions": ["megafamilia_admin"]
    },

    "client_tab": {
        "label": "MegaFamilia",
        "component": "MegaFamiliaClientTab",
        "permission": "megafamilia_support"
    },

    "service_type": {
        "key": "megafamilia",
        "label": "MegaFamilia",
        "price_configurable": false,
