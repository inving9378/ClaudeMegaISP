    "config_sections": [
        {
            "key": "finanzas_facturacion",
            "label": "Finanzas — Facturación",
            "type": "pagos",
            "category": "Finanzas",
            "icon": "file-text",
            "url": "/finanzas/facturas",
            "permission": "finance_edit_billing",
            "description": "Configuración de facturación: días de corte, generación de proformas y recordatorios de cobro.",
            "doc": {
                "terms": [
                    { "term": "Proforma", "definition": "Factura preliminar generada automáticamente antes del corte de cobro." },
                    { "term": "Día de corte", "definition": "Día del mes en que se genera la factura y se intenta cobrar al cliente." }
                ],
                "steps": [
                    "Configurar el día de corte mensual.",
                    "Activar la generación automática de proformas (cron 03:00).",
                    "Configurar recordatorios de cobro por WhatsApp o email."
                ],
                "actions": ["Ver facturas", "Generar proformas manuales", "Exportar reporte"]
            }
        },
        {
            "key": "finanzas_contabilidad",
            "label": "Finanzas — Contabilidad General",
            "type": "pagos",
            "category": "Finanzas",
            "icon": "bar-chart",
            "url": "/finanzas/general-accounting",
            "permission": "finance_view_general_accounting",
            "description": "Registro manual de ingresos y gastos operativos para el estado de resultados.",
            "doc": {
                "terms": [
                    { "term": "Ingreso contable", "definition": "Cualquier entrada de dinero no automatizada (ej. ventas de equipos, servicios extra)." },
                    { "term": "Gasto operativo", "definition": "Egresos del ISP: renta, salarios, servicios, insumos." }
                ],
                "steps": [
                    "Registrar ingresos y gastos del período.",
                    "Ver el balance en el dashboard de contabilidad.",
                    "Exportar el estado de resultados para contabilidad."
                ],
                "actions": ["Registrar ingreso", "Registrar gasto", "Ver dashboard", "Exportar"]
            }
        }
