    "api_endpoints": [
        { "method": "GET", "path": "/finanzas/facturas",           "description": "Lista facturas",        "scope": "finance_view_invoices",          "permission": "finance_view_invoices" },
        { "method": "GET", "path": "/finanzas/pagos",              "description": "Lista pagos",           "scope": "finance_view_payments",          "permission": "finance_view_payments" },
        { "method": "GET", "path": "/finanzas/transacciones",      "description": "Lista transacciones",   "scope": "finance_view_transactions",      "permission": "finance_view_transactions" },
        { "method": "GET", "path": "/finanzas/general-accounting", "description": "Contabilidad general",  "scope": "finance_view_general_accounting", "permission": "finance_view_general_accounting" }
    ],

    "ai": {
        "knowledge": "Finanzas centraliza la información económica del ISP: facturas generadas por cliente, pagos recibidos, transacciones y contabilidad general. El módulo de facturación genera proformas automáticas (cron 03:00) y registra los pagos vinculándolos a cada cliente.",
        "example_intents": [
            "ver los pagos de hoy",
            "cuánto facturó el ISP este mes",
            "ver las facturas pendientes de cobro",
            "registrar un gasto operativo"
        ],
        "sensitive_actions": ["finance_delete_billing", "finance_delete_payments", "finance_delete_transactions"]
    },

