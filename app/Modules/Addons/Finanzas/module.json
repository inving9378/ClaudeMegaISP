            "terms": [
                { "term": "Factura", "definition": "Documento que detalla los cargos de un cliente por su servicio en un periodo." },
                { "term": "Proforma", "definition": "Factura preliminar generada automáticamente cada mes antes de su emisión definitiva." },
                { "term": "Saldo vencido", "definition": "Monto adeudado cuya fecha de pago ya pasó." }
