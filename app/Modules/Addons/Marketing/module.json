                "actions": [
                    "Conectar cuenta Meta",
                    "Ver leads capturados",
                    "Desconectar cuenta"
                ]
            }
        },
        {
            "key": "marketing_openai_tts",
            "label": "Marketing — OpenAI TTS (Video MVM)",
            "type": "api_key",
            "category": "API",
            "icon": "microphone",
            "url": "/integraciones",
            "permission": "manage-integrations",
            "description": "API key de OpenAI usada por el motor de video MVM para generar voz (text-to-speech) en los videos.",
            "doc": {
                "terms": [
                    {
                        "term": "TTS",
                        "definition": "Text-to-Speech — conversión de texto a voz natural."
                    },
                    {
                        "term": "Motor MVM",
                        "definition": "Motor de video de Medussa: combina plantilla + voz + B-roll + texto animado."
                    }
                ],
                "steps": [
                    "Obtener API key en platform.openai.com.",
                    "Ingresarla en Integration Hub bajo el proveedor 'openai'.",
                    "Opcionalmente configurar Pexels API key para B-roll automático."
