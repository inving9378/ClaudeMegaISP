    "config_sections": [
        {
            "key": "red_mikrotik",
            "label": "MikroTik — Conexión RouterOS",
            "type": "api_key",
            "category": "Red",
            "icon": "wifi",
            "url": "/red/router/listar",
            "permission": "router_add_router",
            "description": "Credenciales de acceso RouterOS API para sincronización automática con MikroTik.",
            "doc": {
                "terms": [
                    {
                        "term": "RouterOS API",
                        "definition": "API binaria de MikroTik usada para gestionar colas, IP pools y estados de cliente."
                    },
                    {
                        "term": "ROUTER_LOCAL",
                        "definition": "Flag en .env que habilita la integración MikroTik real."
                    }
                ],
                "steps": [
                    "Ingresar IP, usuario y contraseña de cada router MikroTik.",
                    "Verificar conectividad desde 'Probar conexión'.",
                    "El sync corre automáticamente cada 5 minutos vía cron."
                ],
                "actions": [
                    "Agregar router",
                    "Probar conexión",
                    "Forzar sync"
                ]
            }
        },
        {
            "key": "red_smartolt",
            "label": "SmartOLT — Integración OLT",
            "type": "api_key",
            "category": "Red",
            "icon": "broadcast-tower",
            "url": "/olts",
            "permission": "olt_add",
            "description": "Credenciales y configuración de SmartOLT para gestión de OLTs y ONUs de fibra.",
            "doc": {
                "terms": [
                    {
                        "term": "OLT",
                        "definition": "Optical Line Terminal — equipo central de la red GPON/EPON."
                    },
                    {
                        "term": "ONU",
                        "definition": "Optical Network Unit — dispositivo en casa del cliente que termina la fibra."
                    }
                ],
                "steps": [
                    "Ingresar credenciales de SmartOLT API.",
                    "Agregar OLTs con sus datos de conexión.",
                    "El sync de ONUs corre cada 10 min vía cron."
                ],
                "actions": [
                    "Agregar OLT",
                    "Sincronizar ONUs",
                    "Reboot ONU",
                    "Resincronizar ONU"
                ]
            }
        }
    ],
