            "permission": "dashboard_view_info_invoice_transaction"
        },
        {
            "method": "POST",
            "path": "/get-stats-client-card-in-dashboard-c",
            "description": "Bloque de estadísticas de clientes",
            "scope": "dashboard_view_block_client",
            "permission": "dashboard_view_block_client"
        },
        {
            "method": "POST",
            "path": "/get-stats-ticket-card-in-dashboard-c",
