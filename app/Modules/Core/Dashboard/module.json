    "api_endpoints": [
        {
            "method": "GET",
            "path": "/",
            "description": "Dashboard principal (vista general)",
            "scope": "dashboard_view_dashboard",
            "permission": "dashboard_view_dashboard"
        },
        {
            "method": "GET",
            "path": "/index",
            "description": "Alias de la vista principal del dashboard",
            "scope": "dashboard_view_dashboard",
            "permission": "dashboard_view_dashboard"
        },
        {
            "method": "GET",
            "path": "/home",
            "description": "Alias autenticado de la vista principal del dashboard",
            "scope": "dashboard_view_dashboard",
            "permission": "dashboard_view_dashboard"
        },
        {
            "method": "POST",
            "path": "/get-home-statistics-for-tarjets-by-status-c",
