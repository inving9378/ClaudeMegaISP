        { "method": "GET",  "path": "/cliente/listar",                                        "description": "Listado de clientes",                                "scope": "cliente",              "permission": "client_view_client" },
        { "method": "GET",  "path": "/cliente/crear",                                         "description": "Formulario de alta de cliente",                      "scope": "cliente",              "permission": "client_add_client" },
