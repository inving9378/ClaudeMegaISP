        { "method": "POST", "path": "/cliente/billing/payment/update/{id}",                   "description": "Edita un pago del cliente",                          "scope": "billing.pagos",        "permission": "client_payroll_payment_edit_client" },
        { "method": "POST", "path": "/cliente/billing/payment/destroy/{id}",                  "description": "Elimina un pago del cliente",                        "scope": "billing.pagos",        "permission": "client_payroll_payment_delete_client" },
        { "method": "POST", "path": "/cliente/billing/invoice/crear/{id}",                    "description": "Genera una factura para el cliente",                 "scope": "billing.facturas",     "permission": "client_billing_invoice_add" },
        { "method": "POST", "path": "/cliente/billing/invoice/update/{id}",                   "description": "Edita una factura del cliente",                      "scope": "billing.facturas",     "permission": "client_billing_invoice_edit" },
        { "method": "POST", "path": "/cliente/billing/invoice/destroy/{id}",                  "description": "Elimina una factura del cliente",                    "scope": "billing.facturas",     "permission": "client_billing_invoice_delete" },
        { "method": "POST", "path": "/cliente/billing/transaction/crear/{id}",                "description": "Registra una transacción del cliente",               "scope": "billing.transacciones","permission": "client_billing_transaction_add" },
        { "method": "GET",  "path": "/cliente/billing/datos-fiscales/{clientId}",             "description": "Consulta los datos fiscales CFDI 4.0 del cliente",   "scope": "billing.fiscal",       "permission": "facturacion.ver" },
        { "method": "POST", "path": "/cliente/billing/datos-fiscales/{clientId}",             "description": "Guarda los datos fiscales CFDI 4.0 del cliente",     "scope": "billing.fiscal",       "permission": "facturacion.fiscal.editar" },
        { "method": "POST", "path": "/cliente/billing/datos-fiscales/{clientId}/timbrar",     "description": "Timbra la constancia fiscal del cliente",            "scope": "billing.fiscal",       "permission": "facturacion.fiscal.timbrar" },
        { "method": "POST", "path": "/cliente/clientinternetservice/crear/{id}",              "description": "Contrata un servicio de internet para el cliente",   "scope": "servicios",            "permission": "client_service_internet_add_client" }
    ],
