        { "method": "POST", "path": "/cliente/document/destroy/{id}",                         "description": "Elimina un documento del cliente",                   "scope": "documentos",           "permission": "client_document_delete_client" },
        { "method": "POST", "path": "/cliente/document/generate_contract/{id}",               "description": "Genera el contrato del cliente a partir de plantilla","scope": "documentos",           "permission": "client_document_add_client" },
