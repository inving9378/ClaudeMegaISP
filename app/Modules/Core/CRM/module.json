{
    "slug": "core-crm",
    "name": "CRM",
    "version": "0.1.0",
    "description": "Prospectos, leads y seguimiento comercial.",
    "type": "core",
    "dependencies": [],
    "active": true,
    "menu": [],
    "admin_cards": [],
    "config_sections": [],
    "api_endpoints": [
        { "method": "GET",  "path": "/crm",                                                                                          "description": "Dashboard del módulo CRM",                                          "scope": "dashboard",             "permission": null },
        { "method": "GET",  "path": "/crm/listar",                                                                                    "description": "Lista de prospectos/leads con filtros",                             "scope": "crm_view_crm",          "permission": "crm_view_crm" },
        { "method": "POST", "path": "/crm/table",                                                                                     "description": "Feed de datatable de prospectos",                                   "scope": "crm_view_crm",          "permission": "crm_view_crm" },
        { "method": "GET",  "path": "/crm/crear",                                                                                     "description": "Formulario de alta de prospecto",                                   "scope": "crm_add_crm",           "permission": "crm_add_crm" },
        { "method": "POST", "path": "/crm/add",                                                                                       "description": "Crea un prospecto/lead",                                            "scope": "crm_add_crm",           "permission": "crm_add_crm" },
        { "method": "GET",  "path": "/crm/editar/{id}",                                                                               "description": "Formulario de edición de prospecto",                                "scope": "crm_edit_crm",          "permission": "crm_edit_crm" },
        { "method": "POST", "path": "/crm/update/{id}",                                                                               "description": "Actualiza los datos del prospecto",                                 "scope": "crm_edit_crm",          "permission": "crm_edit_crm" },
        { "method": "POST", "path": "/crm/update-last-contacted/{id}",                                                                "description": "Actualiza la fecha de último contacto del prospecto",              "scope": "crm_edit_crm",          "permission": "crm_edit_crm" },
        { "method": "POST", "path": "/crm/information/{crmId}/get-crm-main-information-id-and-crm-lead-information-id",              "description": "Resuelve los ids internos de información principal y lead del prospecto", "scope": "crm_edit_crm", "permission": "crm_edit_crm" },
        { "method": "GET",  "path": "/crm/success/{id}",                                                                              "description": "Redirige a la edición tras guardar el prospecto",                   "scope": "crm_edit_crm",          "permission": "crm_edit_crm" },
        { "method": "POST", "path": "/crm/destroy/{id}",                                                                              "description": "Elimina un prospecto",                                              "scope": "crm_delete_crm",        "permission": "crm_delete_crm" },
        { "method": "GET",  "path": "/crm/view-of-convert-crm-to-client/{id}",                                                        "description": "Formulario para convertir el prospecto en cliente",                 "scope": "crm_convert_crm",       "permission": "crm_convert_crm" },
        { "method": "POST", "path": "/crm/convert-to-client/{id}",                                                                    "description": "Convierte el prospecto en cliente",                                 "scope": "crm_convert_crm",       "permission": "crm_convert_crm" },
        { "method": "POST", "path": "/crm/document/table",                                                                            "description": "Feed de datatable de documentos del prospecto",                     "scope": "crm_document_view_crm", "permission": "crm_document_view_crm" },
        { "method": "POST", "path": "/crm/document/add/{idCrm}",                                                                      "description": "Agrega un documento al prospecto",                                  "scope": "crm_document_add_crm",  "permission": "crm_document_add_crm" },
        { "method": "POST", "path": "/crm/document/upload-file/{id}",                                                                 "description": "Sube el archivo adjunto de un documento del prospecto",             "scope": "crm_document_add_crm",  "permission": "crm_document_add_crm" },
        { "method": "POST", "path": "/crm/document/generate_contract/{id}",                                                           "description": "Genera el contrato del prospecto desde plantilla",                  "scope": "crm_document_add_crm",  "permission": "crm_document_add_crm" },
        { "method": "GET",  "path": "/crm/document/load_content_template",                                                            "description": "Carga el contenido de una plantilla de documento",                  "scope": "crm_document_add_crm",  "permission": "crm_document_add_crm" },
        { "method": "POST", "path": "/crm/document/show_content_template",                                                            "description": "Previsualiza el contenido de una plantilla de documento",           "scope": "crm_document_add_crm",  "permission": "crm_document_add_crm" },
        { "method": "POST", "path": "/crm/document/update/{idCrm}",                                                                   "description": "Actualiza un documento del prospecto",                              "scope": "crm_document_edit_crm", "permission": "crm_document_edit_crm" },
        { "method": "POST", "path": "/crm/document/destroy/{id}",                                                                     "description": "Elimina un documento del prospecto",                                "scope": "crm_document_delete_crm","permission": "crm_document_delete_crm" }
    ],
    "ai": [],
    "screens": [
        {
