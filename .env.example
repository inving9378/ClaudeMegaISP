APP_NAME=MegaISP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DEPLOY_REMOTE_URL=host
DEPLOY_WEBHOOK_SECRET=tu-token-aqui
SSH_KEY_PASSPHRASE=
# DEPLOY_MIGRATE_TIMEOUT → segundos del paso de migración en prod (RemoteDeployCommand:
#   'migrate' y 'migrate_dryrun'). Default 2400 (40 min) para ALTERs largos sobre tablas
#   grandes. Gobierna el proceso en prod (nohup), NO el --timeout del worker local del .conf.
DEPLOY_MIGRATE_TIMEOUT=2400

# GitHub — auto-actualización y publicación de releases
# GITHUB_TOKEN        → publicador (dev): scope contents:write para crear GitHub Releases
# GITHUB_READ_TOKEN   → consumidor (prod): token de solo lectura (public_repo read basta)
# GITHUB_REPO         → "owner/repo" del repositorio (misma para publicador y consumidor)
# GITHUB_UPDATES_ENABLED → true SOLO en instancias consumidoras (producción)
# UPDATES_MANUAL_CHECK_BUTTON → muestra el botón "Buscar actualizaciones" en el consumidor;
#                       poner en false para ocultarlo cuando ya no se use (default true)
GITHUB_TOKEN=
GITHUB_READ_TOKEN=
GITHUB_REPO=inving9378/ClaudeMegaISP
GITHUB_UPDATES_ENABLED=false
UPDATES_MANUAL_CHECK_BUTTON=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=megaisp
DB_USERNAME=megaisp_user
DB_PASSWORD=tu_password_aqui

#conexion radius (opcional)
DB_RADIUS_HOST=127.0.0.1
DB_RADIUS_DATABASE=radius
DB_RADIUS_USERNAME=radius
DB_RADIUS_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Maps (reemplaza con tu propia API Key)
MIX_VUE_APP_GOOGLEMAPS_KEY=TU_GOOGLE_MAPS_API_KEY_AQUI
MIX_VUE_APP_CENTER_MAP_LATITUDE=19.700586990172585
MIX_VUE_APP_CENTER_MAP_LONGITUDE=-99.07096803188318

# WhatsApp / Evolution API
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=megaisp
WHATSAPP_DEFAULT_INSTANCE=megaisp
WHATSAPP_WEBHOOK_BASE_URL=http://127.0.0.1
WHATSAPP_FAKE=false
WHATSAPP_SENDER_ENABLED=false
WHATSAPP_AUTO_REPLY=false
WHATSAPP_AUTO_REPLY_MIN_CONFIDENCE=0.80
WHATSAPP_AUTO_REPLY_TONE=friendly

# Adaptador Marketing → gateway único WhatsApp (item roadmap #203, Fase A)
# Valores válidos: legacy (default, no-op) | shadow | unified
WHATSAPP_MARKETING_GATEWAY_MODE=legacy

# Claude AI (deja la key vacía; se completa en el servidor)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# Google Maps (server-side; distinto de MIX_VUE_APP_GOOGLEMAPS_KEY del frontend)
GOOGLE_MAPS_API_KEY=

# VoIP / Asterisk AMI
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=megaisp
AMI_SECRET=
AMI_CONTEXT=cobranza-blaster

# Blaster de cobranzas
BLASTER_HORA_INICIO=09:00
BLASTER_HORA_FIN=20:00
BLASTER_MAX_INTENTOS=3
BLASTER_MINUTOS_ENTRE_INTENTOS=180

# Terminal web embebida (DevTools)
TTYD_URL=/ttyd/

# MikroTik (opcional)
ROUTER_LOCAL=false
CONECTION_MIKROTIK=false
# Credenciales de dev para uploadToMikrotik (solo entornos != production).
# Si se dejan vacías se usa la credencial real del router (login_api/password_api).
# NUNCA hardcodear estos valores en el código (ver roadmap item #41).
MIKROTIK_DEV_LOGIN=
MIKROTIK_DEV_PASSWORD=

# Coordenadas de la oficina central (stat "distancia a oficina" en ficha de cliente)
OFFICE_LAT=
OFFICE_LNG=

# Si false, permite crear servicios sin conexión a Mikrotik (para QA/desarrollo).
# En producción debe ser true.
MIKROTIK_REQUIRED_FOR_SERVICE=true

# Huawei OLT — motor propio (B1b-4). Rellenar tras validar sesión B1c.
# Dejar vacíos hasta entonces; cambiar driver='huawei' en la OLT correspondiente
# solo después de que B1c confirme la sesión Telnet con la MA5800-X7.
OLT_HUAWEI_HOST=
OLT_HUAWEI_PORT=23
OLT_HUAWEI_USER=
OLT_HUAWEI_PASS=
OLT_HUAWEI_TRANSPORT=telnet
OLT_HUAWEI_TIMEOUT=30


# ── OpenPay (portal de pago en línea) ───────────────────────────────────────
# Obtener en https://dashboard.openpay.mx (producción) o
# https://sandbox-dashboard.openpay.mx (sandbox)
# NUNCA commitear valores reales en este archivo.
OPENPAY_ID=
OPENPAY_PUBLIC_KEY=
OPENPAY_PRIVATE_KEY=
# true = sandbox (desarrollo/pruebas) | false = producción (tras certificación)
OPENPAY_SANDBOX=true

# Kill-switch de cobros REALES de domiciliación (independiente de OPENPAY_SANDBOX,
# ver config/domiciliacion.php). Flip a true SOLO por decisión explícita de Irving.
DOMICILIACION_COBRO_LIVE_ENABLED=false

CONTRATABLES_BILLING_ENABLED=false
